"use client";

import { useState, useEffect } from "react";
import { supabase } from "@/lib/supabase"; // 确保你的 lib 文件夹下有 supabase.ts

export default function Home() {
  // 1. 状态管理
  const [text, setText] = useState("落霞与孤鹜齐飞，秋水共长天一色。");
  const [font, setFont] = useState("font-kaiti");
  const [user, setUser] = useState<any>(null);

  // 2. 检查登录状态
  useEffect(() => {
    const getUser = async () => {
      const { data } = await supabase.auth.getUser();
      setUser(data.user);
    };
    getUser();
  }, []);

  // 3. 处理练字内容（去除空格和换行以便填入田字格）
  const cleanText = text.replace(/\s+/g, "");

  // 4. 字体样式映射
  const fontStyles: Record<string, string> = {
    "font-kaiti": "font-serif", // 系统自带楷体/宋体
    "font-brush": "font-['Ma_Shan_Zheng',cursive]", // 狂草
    "font-xiaowei": "font-['ZCOOL_XiaoWei',serif]", // 小薇
  };

  // 5. 保存作品到 Supabase 数据库
  const saveWork = async () => {
    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      alert("请先登录！只有登录用户才能保存作品到云端。");
      return;
    }

    const { error } = await supabase.from('copybooks').insert([
      {
        user_id: user.id,
        content: text,
        font_style: font
      }
    ]);

    if (error) {
      alert("保存失败: " + error.message);
    } else {
      alert("🎉 保存成功！你可以在数据库中查看你的作品了。");
    }
  };

  return (
    <main className="bg-slate-50 min-h-screen flex flex-col items-center py-10 text-slate-800">

      {/* 顶部控制面板 - 打印时自动隐藏 */}
      <div className="no-print bg-white p-8 rounded-2xl shadow-sm border border-slate-100 w-full max-w-3xl mb-8 transition-all hover:shadow-md">
        <div className="flex justify-between items-center mb-6">
          <div className="flex items-center gap-3">
            <h1 className="text-3xl font-bold bg-gradient-to-r from-indigo-500 to-purple-600 bg-clip-text text-transparent">
              z-type
            </h1>
            <span className="text-xs px-2 py-1 bg-slate-100 text-slate-500 rounded-md font-mono">v2.1 Pro</span>
          </div>

          <div className="flex gap-3">
            {user ? (
              <span className="text-sm text-slate-500">欢迎, {user.email?.split('@')[0]}</span>
            ) : (
              <button
                onClick={() => window.location.href = '/auth'}
                className="text-sm font-medium text-indigo-600 hover:text-indigo-800"
              >
                登录/注册
              </button>
            )}
          </div>
        </div>

        <div className="space-y-5">
          {/* 输入框 */}
          <div>
            <label className="block text-sm font-medium text-slate-500 mb-2">练字内容</label>
            <textarea
              className="w-full h-28 p-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none transition-all resize-none shadow-inner bg-slate-50/50"
              placeholder="输入你想生成的文字..."
              value={text}
              onChange={(e) => setText(e.target.value)}
            />
          </div>

          {/* 按钮组 */}
          <div className="flex flex-wrap gap-4 items-end">
            <div className="flex-1 min-w-[200px]">
              <label className="block text-sm font-medium text-slate-500 mb-2">切换字体</label>
              <select
                className="w-full p-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none bg-white shadow-sm"
                value={font}
                onChange={(e) => setFont(e.target.value)}
              >
                <option value="font-kaiti">标准楷体 (系统)</option>
                <option value="font-brush">狂草毛笔 (Google Fonts)</option>
                <option value="font-xiaowei">清雅宋体 (ZCOOL)</option>
              </select>
            </div>

            <div className="flex gap-2 w-full sm:w-auto">
              <button
                onClick={saveWork}
                className="flex-1 sm:flex-none px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-xl transition-all shadow-sm active:scale-95"
              >
                保存云端
              </button>
              <button
                onClick={() => window.print()}
                className="flex-1 sm:flex-none px-6 py-3 bg-slate-800 hover:bg-black text-white font-medium rounded-xl transition-all shadow-sm active:scale-95"
              >
                导出 PDF
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* 字帖打印预览区 */}
      <div className="print-area bg-white w-[210mm] min-h-[297mm] shadow-2xl p-[15mm] flex flex-wrap content-start border border-slate-200 rounded-sm">
        {cleanText.split("").map((char, index) => (
          <div
            key={index}
            className={`relative w-[10%] aspect-square border border-red-300 flex justify-center items-center text-5xl text-gray-800 ${fontStyles[font]}`}
          >
            {/* 田字格背景线 */}
            <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
              <div className="w-full h-[1px] border-t border-dashed border-red-200 absolute"></div>
              <div className="h-full w-[1px] border-l border-dashed border-red-200 absolute"></div>
            </div>
            {/* 字符 */}
            <span className="relative z-10 leading-none">{char}</span>
          </div>
        ))}
      </div>

      {/* 全局字体加载 */}
      <style jsx global>{`
        @import url('https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&display=swap');

        @media print {
          .no-print { display: none !important; }
          body { background: white !important; padding: 0 !important; }
          .print-area {
            box-shadow: none !important;
            border: none !important;
            margin: 0 !important;
            padding: 0 !important;
          }
        }
      `}</style>
    </main>
  );
}